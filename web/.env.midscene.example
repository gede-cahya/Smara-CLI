# MidsceneJS model configuration
# Copy this file to .env and fill your key.

MIDSCENE_MODEL_BASE_URL="https://openrouter.ai/api/v1"
MIDSCENE_MODEL_API_KEY="your-openrouter-api-key"
MIDSCENE_MODEL_NAME="qwen/qwen3.7-plus"
MIDSCENE_MODEL_FAMILY="qwen3"

# Optional for local Smara web automation
SMARA_WEB_URL="http://localhost:5173"
MIDSCENE_PROMPT="describe the main UI sections and important controls on this page"
HEADLESS="false"
