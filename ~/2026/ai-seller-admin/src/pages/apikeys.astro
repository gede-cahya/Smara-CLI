---
import Layout from '../layouts/Layout.astro';
---
<Layout title="API Keys" active="apikeys">
  <div class="flex items-center justify-between mb-6">
    <div class="flex items-center gap-4">
      <input id="search" type="text" placeholder="Search by name or key prefix..." class="px-4 py-2.5 bg-dark-900 border border-dark-800 rounded-lg text-dark-100 focus:outline-none focus:ring-2 focus:ring-primary-500 w-72" />
      <select id="status-filter" class="px-4 py-2.5 bg-dark-900 border border-dark-800 rounded-lg text-dark-100 focus:outline-none focus:ring-2 focus:ring-primary-500">
        <option value="">All Status</option>
        <option value="active">Active</option>
        <option value="revoked">Revoked</option>
      </select>
    </div>
    <button onclick="loadKeys()" class="px-4 py-2.5 bg-primary-600 hover:bg-primary-700 text-white rounded-lg text-sm font-medium transition">Refresh</button>
  </div>

  <!-- Stats -->
  <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
    <div class="bg-dark-900 rounded-xl p-4 border border-dark-800">
      <p class="text-xs text-dark-400">Total Keys</p>
      <p id="keys-total" class="text-2xl font-bold text-dark-100">0</p>
    </div>
    <div class="bg-dark-900 rounded-xl p-4 border border-dark-800">
      <p class="text-xs text-dark-400">Active Keys</p>
      <p id="keys-active" class="text-2xl font-bold text-green-400">0</p>
    </div>
    <div class="bg-dark-900 rounded-xl p-4 border border-dark-800">
      <p class="text-xs text-dark-400">Revoked Keys</p>
      <p id="keys-revoked" class="text-2xl font-bold text-red-400">0</p>
    </div>
    <div class="bg-dark-900 rounded-xl p-4 border border-dark-800">
      <p class="text-xs text-dark-400">Total Requests</p>
      <p id="keys-requests" class="text-2xl font-bold text-primary-400">0</p>
    </div>
  </div>

  <div class="bg-dark-900 rounded-xl border border-dark-800 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead>
          <tr class="border-b border-dark-800 bg-dark-900/50">
            <th class="text-left py-3 px-4 text-xs font-medium text-dark-400 uppercase">ID</th>
            <th class="text-left py-3 px-4 text-xs font-medium text-dark-400 uppercase">Name</th>
            <th class="text-left py-3 px-4 text-xs font-medium text-dark-400 uppercase">Key Prefix</th>
            <th class="text-left py-3 px-4 text-xs font-medium text-dark-400 uppercase">Owner (User ID)</th>
            <th class="text-left py-3 px-4 text-xs font-medium text-dark-400 uppercase">Requests</th>
            <th class="text-left py-3 px-4 text-xs font-medium text-dark-400 uppercase">Status</th>
            <th class="text-left py-3 px-4 text-xs font-medium text-dark-400 uppercase">Created</th>
            <th class="text-left py-3 px-4 text-xs font-medium text-dark-400 uppercase">Last Used</th>
            <th class="text-left py-3 px-4 text-xs font-medium text-dark-400 uppercase">Actions</th>
          </tr>
        </thead>
        <tbody id="keys-body">
          <tr><td colspan="9" class="text-center py-12 text-dark-500">Loading...</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <script is:inline>
    let allKeys = [];

    async function loadKeys() {
      const data = await apiGet('/apikeys');
      if (!data || data.error) return;
      allKeys = Array.isArray(data) ? data : [];

      const active = allKeys.filter(k => !k.is_revoked);
      const revoked = allKeys.filter(k => k.is_revoked);
      const totalReqs = allKeys.reduce((a, k) => a + (k.request_count || 0), 0);

      document.getElementById('keys-total').textContent = allKeys.length;
      document.getElementById('keys-active').textContent = active.length;
      document.getElementById('keys-revoked').textContent = revoked.length;
      document.getElementById('keys-requests').textContent = totalReqs;

      renderKeys();
    }

    function renderKeys() {
      const search = document.getElementById('search').value.toLowerCase();
      const statusF = document.getElementById('status-filter').value;
      let filtered = allKeys.filter(k => {
        const matchSearch = !search || (k.name||'').toLowerCase().includes(search) || (k.key_prefix||'').toLowerCase().includes(search);
        const matchStatus = !statusF || (statusF === 'active' && !k.is_revoked) || (statusF === 'revoked' && k.is_revoked);
        return matchSearch && matchStatus;
      });

      const tbody = document.getElementById('keys-body');
      if (filtered.length === 0) {
        tbody.innerHTML = '<tr><td colspan="9" class="text-center py-12 text-dark-500">No API keys found</td></tr>';
        return;
      }

      tbody.innerHTML = filtered.map(k => `
        <tr class="border-b border-dark-800/50 hover:bg-dark-800/30 transition">
          <td class="py-3 px-4 text-sm text-dark-300">${k.id}</td>
          <td class="py-3 px-4 text-sm text-dark-200">${k.name || '-'}</td>
          <td class="py-3 px-4 text-sm text-dark-200 font-mono">${k.key_prefix}...</td>
          <td class="py-3 px-4 text-sm text-dark-300">${k.user_id}</td>
          <td class="py-3 px-4 text-sm text-dark-300">${k.request_count || 0}</td>
          <td class="py-3 px-4">${k.is_revoked ? '<span class="px-2 py-1 rounded-full text-xs bg-red-600/30 text-red-300">Revoked</span>' : '<span class="px-2 py-1 rounded-full text-xs bg-green-600/30 text-green-300">Active</span>'}</td>
          <td class="py-3 px-4 text-sm text-dark-400">${new Date(k.created_at).toLocaleString('id-ID')}</td>
          <td class="py-3 px-4 text-sm text-dark-400">${k.last_used_at ? new Date(k.last_used_at).toLocaleString('id-ID') : 'Never'}</td>
          <td class="py-3 px-4">
            ${k.is_revoked
              ? `<button onclick="restoreKey(${k.id})" class="px-2 py-1 text-xs bg-green-600/30 hover:bg-green-600/50 text-green-300 rounded">Restore</button>`
              : `<button onclick="revokeKey(${k.id})" class="px-2 py-1 text-xs bg-red-600/30 hover:bg-red-600/50 text-red-300 rounded">Revoke</button>`
            }
          </td>
        </tr>
      `).join('');
    }

    async function revokeKey(id) {
      if (!confirm(`Revoke API Key #${id}?`)) return;
      const res = await apiPost(`/apikeys/${id}/revoke`);
      if (res && !res.error) loadKeys();
      else alert(res.error || 'Failed');
    }

    async function restoreKey(id) {
      if (!confirm(`Restore API Key #${id}?`)) return;
      const res = await apiPost(`/apikeys/${id}/restore`);
      if (res && !res.error) loadKeys();
      else alert(res.error || 'Failed');
    }

    document.getElementById('search').addEventListener('input', renderKeys);
    document.getElementById('status-filter').addEventListener('change', renderKeys);

    document.addEventListener('DOMContentLoaded', () => {
      if (authToken) loadKeys();
      else { const orig = hideLoginModal; hideLoginModal = () => { orig(); loadKeys(); }; }
    });
  </script>
</Layout>
