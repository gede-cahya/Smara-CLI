---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Transactions" active="transactions">
  <div class="flex items-center justify-between mb-6">
    <div class="flex items-center gap-4">
      <select id="status-filter" class="px-4 py-2.5 bg-dark-900 border border-dark-800 rounded-lg text-dark-100 focus:outline-none focus:ring-2 focus:ring-primary-500">
        <option value="">All Status</option>
        <option value="pending">Pending</option>
        <option value="success">Success</option>
        <option value="failed">Failed</option>
        <option value="expired">Expired</option>
      </select>
    </div>
    <div class="flex items-center gap-3">
      <button onclick="exportCSV()" class="px-4 py-2.5 bg-dark-800 hover:bg-dark-700 text-dark-200 rounded-lg text-sm font-medium transition border border-dark-700">📥 Export CSV</button>
      <button onclick="loadTransactions()" class="px-4 py-2.5 bg-primary-600 hover:bg-primary-700 text-white rounded-lg text-sm font-medium transition">Refresh</button>
    </div>
  </div>

  <!-- Stats -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
    <div class="bg-dark-900 rounded-xl p-4 border border-dark-800">
      <p class="text-xs text-dark-400">Total Revenue</p>
      <p id="tx-revenue" class="text-2xl font-bold text-green-400">Rp 0</p>
    </div>
    <div class="bg-dark-900 rounded-xl p-4 border border-dark-800">
      <p class="text-xs text-dark-400">Pending Payments</p>
      <p id="tx-pending" class="text-2xl font-bold text-yellow-400">0</p>
    </div>
    <div class="bg-dark-900 rounded-xl p-4 border border-dark-800">
      <p class="text-xs text-dark-400">Total Transactions</p>
      <p id="tx-total" class="text-2xl font-bold text-dark-100">0</p>
    </div>
  </div>

  <div class="bg-dark-900 rounded-xl border border-dark-800 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead>
          <tr class="border-b border-dark-800 bg-dark-900/50">
            <th class="text-left py-3 px-4 text-xs font-medium text-dark-400 uppercase">ID</th>
            <th class="text-left py-3 px-4 text-xs font-medium text-dark-400 uppercase">User ID</th>
            <th class="text-left py-3 px-4 text-xs font-medium text-dark-400 uppercase">Tier</th>
            <th class="text-left py-3 px-4 text-xs font-medium text-dark-400 uppercase">Amount</th>
            <th class="text-left py-3 px-4 text-xs font-medium text-dark-400 uppercase">Status</th>
            <th class="text-left py-3 px-4 text-xs font-medium text-dark-400 uppercase">External ID</th>
            <th class="text-left py-3 px-4 text-xs font-medium text-dark-400 uppercase">Created</th>
            <th class="text-left py-3 px-4 text-xs font-medium text-dark-400 uppercase">Paid At</th>
          </tr>
        </thead>
        <tbody id="tx-body">
          <tr><td colspan="8" class="text-center py-12 text-dark-500">Loading...</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <script is:inline>
    let allTx = [];

    async function loadTransactions() {
      const data = await apiGet('/transactions');
      if (!data || data.error) return;
      allTx = Array.isArray(data) ? data : [];

      const success = allTx.filter(t => t.payment_status === 'success');
      const revenue = success.reduce((a, t) => a + (parseFloat(t.amount) || 0), 0);
      const pending = allTx.filter(t => t.payment_status === 'pending').length;

      document.getElementById('tx-revenue').textContent = 'Rp ' + revenue.toLocaleString();
      document.getElementById('tx-pending').textContent = pending;
      document.getElementById('tx-total').textContent = allTx.length;

      renderTransactions();
    }

    function renderTransactions() {
      const filter = document.getElementById('status-filter').value;
      const filtered = filter ? allTx.filter(t => t.payment_status === filter) : allTx;

      const tbody = document.getElementById('tx-body');
      if (filtered.length === 0) {
        tbody.innerHTML = '<tr><td colspan="8" class="text-center py-12 text-dark-500">No transactions</td></tr>';
        return;
      }

      tbody.innerHTML = filtered.map(t => `
        <tr class="border-b border-dark-800/50 hover:bg-dark-800/30 transition">
          <td class="py-3 px-4 text-sm text-dark-300">${t.id}</td>
          <td class="py-3 px-4 text-sm text-dark-200 font-mono">${t.user_id}</td>
          <td class="py-3 px-4"><span class="px-2 py-1 rounded-full text-xs font-medium ${tierBadge(t.tier)}">${t.tier}</span></td>
          <td class="py-3 px-4 text-sm text-dark-200">Rp ${(parseFloat(t.amount)||0).toLocaleString()}</td>
          <td class="py-3 px-4">${statusBadge(t.payment_status)}</td>
          <td class="py-3 px-4 text-xs text-dark-400 font-mono">${t.external_id || '-'}</td>
          <td class="py-3 px-4 text-sm text-dark-400">${new Date(t.created_at).toLocaleString('id-ID')}</td>
          <td class="py-3 px-4 text-sm text-dark-400">${t.paid_at ? new Date(t.paid_at).toLocaleString('id-ID') : '-'}</td>
        </tr>
      `).join('');
    }

    function tierBadge(tier) {
      const map = { free:'bg-gray-600/30 text-gray-300', basic:'bg-blue-600/30 text-blue-300', premium:'bg-purple-600/30 text-purple-300', enterprise:'bg-yellow-600/30 text-yellow-300' };
      return map[tier] || map.free;
    }

    function statusBadge(s) {
      const map = { pending:'bg-yellow-600/30 text-yellow-300', success:'bg-green-600/30 text-green-300', failed:'bg-red-600/30 text-red-300', expired:'bg-gray-600/30 text-gray-300' };
      return `<span class="px-2 py-1 rounded-full text-xs font-medium ${map[s]||map.pending}">${s}</span>`;
    }

    function exportCSV() {
      if (allTx.length === 0) { alert('No data to export'); return; }
      const headers = ['ID','User ID','Tier','Amount','Status','External ID','Created','Paid At'];
      const rows = allTx.map(t => [t.id, t.user_id, t.tier, t.amount, t.payment_status, t.external_id||'', t.created_at, t.paid_at||'']);
      const csv = [headers, ...rows].map(r => r.join(',')).join('\n');
      const blob = new Blob([csv], { type: 'text/csv' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `transactions_${new Date().toISOString().split('T')[0]}.csv`;
      a.click();
    }

    document.getElementById('status-filter').addEventListener('change', renderTransactions);

    document.addEventListener('DOMContentLoaded', () => {
      if (authToken) loadTransactions();
      else { const orig = hideLoginModal; hideLoginModal = () => { orig(); loadTransactions(); }; }
    });
  </script>
</Layout>
